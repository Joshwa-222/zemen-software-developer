# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/zemen
JWT_SECRET=replace-with-a-long-random-secret
# Generate a bcrypt hash for your chosen admin password and put it here.
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
CLIENT_ORIGIN=http://localhost:5173